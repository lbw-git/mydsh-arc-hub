{
  "name": "dsh-arc-hub",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "ArcDream Hub bridge: encrypted Hela persona, hub status/mode tools, open directory, standalone WPS Office automation (info/open/print/convert via wpscli), anchor prompt.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "wps.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
